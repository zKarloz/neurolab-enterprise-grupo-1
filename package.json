{
  "name": "neurolab-enterprise",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:structure": "node --test tests/structure.test.mjs",
    "test:rls:live": "node --env-file=.env.local scripts/verify-fase1.mjs",
    "test:deploy": "node scripts/verify-deployment.mjs",
    "test:projects": "node --test tests/projects.structure.test.mjs",
    "test:design": "node --test tests/design.structure.test.mjs",
    "test:fase2:live": "node --env-file=.env.test.local scripts/test-fase2-live.mjs",
    "test:preprocessing": "node --experimental-strip-types --test tests/preprocessing.test.mjs",
    "test:network": "node --experimental-strip-types --test tests/network-config.test.mjs",
    "test:training:runtime": "node --experimental-strip-types --test tests/training.runtime.test.mjs",
    "test:auth-refresh": "node --experimental-strip-types --test tests/auth-refresh.test.mjs",
    "test:target-analysis": "node --experimental-strip-types --test tests/target-analysis.test.mjs",
    "test:fase3:live": "node --env-file=.env.test.local scripts/test-fase3-live.mjs",
    "test:persistence": "node --experimental-strip-types --test tests/persistence.test.mjs",
    "test:evaluation": "node --experimental-strip-types --test tests/evaluation.test.mjs tests/history.test.mjs tests/fase4.structure.test.mjs",
    "test:fase4:prediction": "node --experimental-strip-types --test tests/fase4.prediction-comparison.test.mjs tests/fase4.prediction-structure.test.mjs",
    "test:fase4:live": "node --experimental-strip-types --env-file=.env.test.local scripts/test-fase4-live.mjs",
    "test:fase5": "node --experimental-strip-types --test tests/fase5.manifest.test.mjs tests/fase5.security.test.mjs",
    "test:fase5:runtime": "node --experimental-strip-types --test tests/fase5.runtime.test.mjs",
    "test:fase5:live": "node --env-file=.env.test.local scripts/test-fase5-live.mjs",
    "test:fase6": "node --experimental-strip-types --test tests/fase6.admin-policy.test.mjs tests/fase6.security-structure.test.mjs",
    "test:fase6:live": "node --env-file=.env.test.local scripts/test-fase6-live.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.3",
    "papaparse": "5.7.0",
    "@tensorflow/tfjs": "4.22.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "@types/papaparse": "5.5.2"
  }
}
